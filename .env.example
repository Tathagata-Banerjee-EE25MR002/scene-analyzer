# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Required on any deployment people can reach over the internet (the Docker image refuses to start without it)
# APP_PASSWORD=choose-a-long-passphrase
# APP_USERNAME=user

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5   # any vision-capable Claude model
# MAX_IMAGE_EDGE=1568              # longest image side sent to the model (px)
# MAX_UPLOAD_MB=20
# MAX_IMAGE_MEGAPIXELS=50
# MAX_OUTPUT_TOKENS=8192
# RATE_LIMIT_PER_MIN=10            # per client IP, 0 = off
# GLOBAL_RATE_LIMIT_PER_MIN=60     # across everyone, 0 = off
# MAX_CONCURRENT=4
# ANTHROPIC_TIMEOUT_S=90
# ANTHROPIC_MAX_RETRIES=2
